{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japboy.github.io/schemas/cv.schema.json",
  "title": "Public curriculum vitae",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "anonymization",
    "profile",
    "skills",
    "organizations",
    "engagements",
    "highlights",
    "activities",
    "statement"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "$ref": "#/$defs/source" },
    "anonymization": { "$ref": "#/$defs/anonymization" },
    "profile": { "$ref": "#/$defs/profile" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skillGroup" }
    },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/organization" }
    },
    "engagements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/engagement" }
    },
    "highlights": {
      "type": "array",
      "items": { "$ref": "#/$defs/highlight" }
    },
    "activities": {
      "type": "array",
      "items": { "$ref": "#/$defs/activity" }
    },
    "statement": { "$ref": "#/$defs/statement" }
  },
  "$defs": {
    "closedObject": {
      "type": "object",
      "additionalProperties": false
    },
    "yearMonth": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/yearMonth" },
        "end": { "$ref": "#/$defs/yearMonth" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "issued_on", "coverage", "note"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "issued_on": { "type": "string", "format": "date" },
        "coverage": { "$ref": "#/$defs/period" },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "anonymization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "policy", "identifiers_published"],
      "properties": {
        "mode": { "const": "organization-and-product" },
        "policy": { "$ref": "#/$defs/nonEmptyString" },
        "identifiers_published": { "const": false }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "summary"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "skillGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/skill" }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "years", "level", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "years": { "type": "integer", "minimum": 0 },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relationship", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "relationship": { "enum": ["freelance-client", "employer"] },
        "profile": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organization_id",
        "period",
        "headline",
        "roles",
        "summary",
        "responsibilities",
        "stack"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "organization_id": { "$ref": "#/$defs/nonEmptyString" },
        "period": { "$ref": "#/$defs/period" },
        "headline": { "$ref": "#/$defs/nonEmptyString" },
        "roles": { "$ref": "#/$defs/nonEmptyStrings" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "responsibilities": { "$ref": "#/$defs/nonEmptyStrings" },
        "stack": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "engagement_id", "title", "summary", "principles"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "engagement_id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "principles": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "period", "items"],
      "properties": {
        "organization_id": { "$ref": "#/$defs/nonEmptyString" },
        "period": { "$ref": "#/$defs/nonEmptyString" },
        "items": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "paragraphs"],
      "properties": {
        "heading": { "$ref": "#/$defs/nonEmptyString" },
        "paragraphs": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
