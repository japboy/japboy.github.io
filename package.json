{
  "name": "japboy.github.io",
  "version": "2026",
  "private": true,
  "description": "Portfolio about Yu Inao",
  "author": "Yu Inao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japboy/japboy.github.io.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run build:client && pnpm run prerender",
    "build:client": "vite build",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "dev": "vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm run format:check && pnpm run typecheck",
    "prepare": "lefthook install",
    "prerender": "tsx bin/prerender.ts",
    "preview": "vite preview",
    "start": "pnpm run dev",
    "test": "tsx --test",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@lit-labs/ssr-client": "1.1.8",
    "@litert-lm/core": "0.14.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@lit-labs/ssr": "4.1.0",
    "@types/node": "24.13.3",
    "ajv": "8.17.1",
    "browserslist": "4.28.6",
    "browserslist-to-esbuild": "2.1.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.59.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.15.0"
  },
  "packageManager": "pnpm@11.15.0"
}
